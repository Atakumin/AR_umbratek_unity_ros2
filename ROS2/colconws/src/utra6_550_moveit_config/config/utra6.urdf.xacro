<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="utra6">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import utra6 urdf file -->
    <xacro:include filename="$(find arm_description)/urdf/utra6.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="utra6.ros2_control.xacro" />


    <xacro:utra6_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
