  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<ros2_control name=\"utra6_550\" type=\"system\">\r\n  <hardware>\r\n   
    <plugin>ur_robot_driver/URPositionHardwareInterface</plugin>\r\n    <param name=\"robot_ip\">0.0.0.0</param>\r\n   
    <param name=\"headless_mode\">False</param>\r\n    <param name=\"tf_prefix\">\"\"</param>\r\n   
    <param name=\"non_blocking_read\">0</param>\r\n    <param name=\"kinematics/hash\">calib_12788084448423163542</param>\r\n 
    </hardware>\r\n  <joint name=\"joint1\">\r\n    <command_interface name=\"position\">\r\n     
    <param name=\"min\">{-2*pi}</param>\r\n      <param name=\"max\">{2*pi}</param>\r\n   
    </command_interface>\r\n    <command_interface name=\"velocity\">\r\n      <param
    name=\"min\">-3.15</param>\r\n      <param name=\"max\">3.15</param>\r\n    </command_interface>\r\n   
