  m_Script: {fileID: 11500000, guid: 76add797bdb1d8c4b8276633f6e67167, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  PluginText: "<ros2_control name=\"utra6\" type=\"system\">\r\n  <hardware>\r\n   
    <plugin>mock_components/GenericSystem</plugin>\r\n  </hardware>\r\n  <joint name=\"joint1\">\r\n   
    <command_interface name=\"position\">\r\n      <param name=\"min\">{-2*pi}</param>\r\n     
    <param name=\"max\">{2*pi}</param>\r\n    </command_interface>\r\n    <command_interface
    name=\"velocity\">\r\n      <param name=\"min\">-3.15</param>\r\n      <param
    name=\"max\">3.15</param>\r\n    </command_interface>\r\n    <state_interface
    name=\"position\">\r\n      <param name=\"initial_value\">0</param>\r\n    </state_interface>\r\n   
    <state_interface name=\"velocity\" />\r\n    <state_interface name=\"effort\"
    />\r\n  </joint>\r\n  <joint name=\"joint2\">\r\n    <command_interface name=\"position\">\r\n     
    <param name=\"min\">{-2*pi}</param>\r\n      <param name=\"max\">{2*pi}</param>\r\n   
    </command_interface>\r\n    <command_interface name=\"velocity\">\r\n      <param
    name=\"min\">-3.15</param>\r\n      <param name=\"max\">3.15</param>\r\n    </command_interface>\r\n   
    <state_interface name=\"position\">\r\n      <param name=\"initial_value\">0</param>\r\n   
    </state_interface>\r\n    <state_interface name=\"velocity\" />\r\n    <state_interface
    name=\"effort\" />\r\n  </joint>\r\n  <joint name=\"joint3\">\r\n    <command_interface
    name=\"position\">\r\n      <param name=\"min\">{-pi}</param>\r\n      <param
    name=\"max\">{pi}</param>\r\n    </command_interface>\r\n    <command_interface
    name=\"velocity\">\r\n      <param name=\"min\">-3.15</param>\r\n      <param
    name=\"max\">3.15</param>\r\n    </command_interface>\r\n    <state_interface
    name=\"position\">\r\n      <param name=\"initial_value\">0</param>\r\n    </state_interface>\r\n   
    <state_interface name=\"velocity\" />\r\n    <state_interface name=\"effort\"
    />\r\n  </joint>\r\n  <joint name=\"joint4\">\r\n    <command_interface name=\"position\">\r\n     
    <param name=\"min\">{-2*pi}</param>\r\n      <param name=\"max\">{2*pi}</param>\r\n   
    </command_interface>\r\n    <command_interface name=\"velocity\">\r\n      <param
    name=\"min\">-3.2</param>\r\n      <param name=\"max\">3.2</param>\r\n    </command_interface>\r\n   
    <state_interface name=\"position\">\r\n      <param name=\"initial_value\">0</param>\r\n   
    </state_interface>\r\n    <state_interface name=\"velocity\" />\r\n    <state_interface
    name=\"effort\" />\r\n  </joint>\r\n  <joint name=\"joint5\">\r\n    <command_interface
    name=\"position\">\r\n      <param name=\"min\">{-2*pi}</param>\r\n      <param
    name=\"max\">{2*pi}</param>\r\n    </command_interface>\r\n    <command_interface
    name=\"velocity\">\r\n      <param name=\"min\">-3.2</param>\r\n      <param
    name=\"max\">3.2</param>\r\n    </command_interface>\r\n    <state_interface
    name=\"position\">\r\n      <param name=\"initial_value\">0</param>\r\n    </state_interface>\r\n   
    <state_interface name=\"velocity\" />\r\n    <state_interface name=\"effort\"
    />\r\n  </joint>\r\n  <joint name=\"joint6\">\r\n    <command_interface name=\"position\">\r\n     
    <param name=\"min\">{-2*pi}</param>\r\n      <param name=\"max\">{2*pi}</param>\r\n   
    </command_interface>\r\n    <command_interface name=\"velocity\">\r\n      <param
    name=\"min\">-3.2</param>\r\n      <param name=\"max\">3.2</param>\r\n    </command_interface>\r\n   
    <state_interface name=\"position\">\r\n      <param name=\"initial_value\">0</param>\r\n   
    </state_interface>\r\n    <state_interface name=\"velocity\" />\r\n    <state_interface
    name=\"effort\" />\r\n  </joint>\r\n  <sensor name=\"tcp_fts_sensor\">\r\n   
    <state_interface name=\"force.x\" />\r\n    <state_interface name=\"force.y\"
    />\r\n    <state_interface name=\"force.z\" />\r\n    <state_interface name=\"torque.x\"
    />\r\n    <state_interface name=\"torque.y\" />\r\n    <state_interface name=\"torque.z\"
    />\r\n  </sensor>\r\n  <!-- NOTE The following are joints used only for testing
    with fake hardware and will change in the future -->\r\n  <gpio name=\"speed_scaling\">\r\n   
    <state_interface name=\"speed_scaling_factor\" />\r\n    <param name=\"initial_speed_scaling_factor\">1</param>\r\n   
    <command_interface name=\"target_speed_fraction_cmd\" />\r\n    <command_interface
    name=\"target_speed_fraction_async_success\" />\r\n  </gpio>\r\n  <gpio name=\"gpio\">\r\n   
    <command_interface name=\"standard_digital_output_cmd_0\" />\r\n    <command_interface
    name=\"standard_digital_output_cmd_1\" />\r\n    <command_interface name=\"standard_digital_output_cmd_2\"
