    />\r\n    <state_interface name=\"digital_output_15\" />\r\n    <state_interface
    name=\"digital_output_16\" />\r\n    <state_interface name=\"digital_output_17\"
    />\r\n    <state_interface name=\"digital_input_0\" />\r\n    <state_interface
