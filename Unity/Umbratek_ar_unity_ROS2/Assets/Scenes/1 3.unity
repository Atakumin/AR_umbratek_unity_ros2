    />\r\n    <state_interface name=\"digital_input_3\" />\r\n    <state_interface
    name=\"digital_input_4\" />\r\n    <state_interface name=\"digital_input_5\"
    />\r\n    <state_interface name=\"digital_input_6\" />\r\n    <state_interface
